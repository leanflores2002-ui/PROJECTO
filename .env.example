# Backend / Render
ENVIRONMENT=development
DATABASE_URL=
DATABASE_POOL_SIZE=5
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
PUBLIC_FRONTEND_ORIGIN=
ADMIN_FRONTEND_ORIGIN=
ROMIX_CATALOG_SOURCE=database
# ROMIX_PRODUCTS_FILE: omití esta variable si usás el archivo por defecto.

# Supabase (backend only; never expose the service role key in Vite)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
ADMIN_PATH=/admin

# frontend/admin (safe browser variables)
VITE_API_URL=http://localhost:8000
VITE_PUBLIC_SITE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_PATH=/admin
# Sólo backend: ID numérico de la propiedad (no el G-... del tag).
GA4_PROPERTY_ID=
# Archivo privado de cuenta de servicio con acceso de lectura a GA4.
GOOGLE_APPLICATION_CREDENTIALS=
