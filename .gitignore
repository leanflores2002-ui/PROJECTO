# Dependencias
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Temporales y copias locales
tmp_*
temp_*
*.tmp
frontend/public/assets/data/product_dump.txt
frontend/public/assets/data/temp_*.txt

# Entorno/editor
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.vscode/
.idea/

# Miniaturas derivadas opcionales
# La app conserva la imagen original como fallback y puede derivar rutas de miniatura.
frontend/public/images/thumbs/*-thumb.jpg
frontend/public/images/thumbs/*-thumb.avif

# Local audit and tooling
reports/
.storage-tools/
.vercel/
*.log
test-results/
playwright-report/

# Deterministic output generated by npm run generate:share-pages (no bot commits)
frontend/public/share/
frontend/public/share-previews/
frontend/public/assets/data/share-manifest.json
frontend/public/assets/js/share-versions.js
