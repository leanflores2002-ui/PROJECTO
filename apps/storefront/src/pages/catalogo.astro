---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Catálogo · ROMIX" description="Ruta base del catálogo ROMIX.">
  <section class="page">
    <h1>Catálogo</h1>
    <p>La lectura de productos se conectará a <code>/api/public/products</code> una vez definida la migración D1 del catálogo.</p>
    <a href="/">Volver al inicio</a>
  </section>
</BaseLayout>

<style>
  .page { padding: 5rem clamp(1.25rem, 8vw, 8rem); }
  h1 { font-size: clamp(2.25rem, 6vw, 4rem); }
  a { color: inherit; }
</style>
