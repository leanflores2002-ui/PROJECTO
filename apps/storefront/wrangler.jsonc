{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "romix-storefront",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
